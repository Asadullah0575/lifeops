{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "dynamodb:*",
        "lambda:*",
        "logs:*",
        "bedrock:*",
        "bedrock-agentcore:*",
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetRolePolicy",
        "cloudformation:*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
